{
  "manifest_version": 3,
  "name": "StreamGrab",
  "version": "1.0.0",
  "description": "Adds a “Download this video” button with a quality menu over videos, and downloads them with the StreamGrab Mac app.",
  "key": "",
  "permissions": ["webRequest", "webNavigation", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "StreamGrab",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
